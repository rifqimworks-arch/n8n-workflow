    {
      "parameters": {
        "promptType": "define",
        "text": "=Kamu adalah analis tiket Jira yang berpengalaman. Analisa tiket berikut dan berikan output terstruktur.\n\n**Data Tiket:**\n- Issue Key: {{ $json.key }}\n- Judul: {{ $json.fields.summary }}\n- Deskripsi: {{ $json.fields.description ?? 'Tidak ada deskripsi' }}\n- Status: {{ $json.fields.status.name }}\n- Prioritas: {{ $json.fields.priority.name }}\n- Tipe Issue: {{ $json.fields.issuetype.name }}\n- Assignee: {{ $json.fields.assignee?.displayName ?? 'Unassigned' }}\n- Reporter: {{ $json.fields.reporter?.displayName ?? 'Unknown' }}\n- Dibuat: {{ $json.fields.created }}\n- Label: {{ $json.fields.labels.join(', ') || 'Tidak ada label' }}\n\nBerikan analisa dalam format JSON berikut (HANYA output JSON, tanpa penjelasan tambahan):\n{\n  \"kategori\": \"Bug | Feature Request | Improvement | Task | Support\",\n  \"tingkat_urgensi\": \"Sangat Tinggi | Tinggi | Sedang | Rendah\",\n  \"estimasi_kompleksitas\": \"Simple | Medium | Complex\",\n  \"ringkasan\": \"Ringkasan singkat 1-2 kalimat tentang tiket ini\",\n  \"rekomendasi_aksi\": \"Langkah konkret yang harus dilakukan\",\n  \"potensi_dampak\": \"Dampak jika tidak diselesaikan\",\n  \"skor_prioritas\": \"1-10\"\n}",
        "options": {
          "systemMessage": "Kamu adalah asisten analis tiket yang membantu tim engineering memahami dan memprioritaskan pekerjaan. Selalu jawab dalam Bahasa Indonesia dan kembalikan HANYA valid JSON tanpa markdown code block."
        }
      },
      "id": "209eb38b-5cc7-46fa-85cb-ac6b9f6dad68",
      "name": "AI Agent: Analisa Tiket",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        64,
        784
      ]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Jira: Get Issue Detail').item.json.key }}"
      },
      "id": "4de2d265-35d0-4c49-ad70-4d0f889344ad",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.2,
      "position": [
        160,
        1024
      ]
    },
    {
      "parameters": {
        "jsCode": "// Ambil data dari node-node sebelumnya\nconst jiraData = $('Jira: Get Issue Detail').item.json;\nconst aiRawOutput = $('AI Agent: Analisa Tiket').item.json.text;\n\n// Parse output AI (bersihkan jika ada markdown)\nlet aiAnalysis = {};\ntry {\n  const cleaned = aiRawOutput\n    .replace(/```json\\n?/gi, '')\n    .replace(/```\\n?/gi, '')\n    .trim();\n  aiAnalysis = JSON.parse(cleaned);\n} catch (e) {\n  aiAnalysis = {\n    kategori: 'Tidak Teridentifikasi',\n    tingkat_urgensi: 'Sedang',\n    estimasi_kompleksitas: 'Medium',\n    ringkasan: (aiRawOutput || '').substring(0, 200),\n    rekomendasi_aksi: 'Periksa tiket secara manual',\n    potensi_dampak: 'Tidak diketahui',\n    skor_prioritas: '5'\n  };\n}\n\n// Format tanggal\nconst formatDate = (dateStr) => {\n  if (!dateStr) return '-';\n  return new Date(dateStr).toLocaleString('id-ID', {\n    day: '2-digit', month: 'long', year: 'numeric',\n    hour: '2-digit', minute: '2-digit'\n  });\n};\n\n// Susun baris data untuk spreadsheet\nconst row = {\n  issue_key: jiraData.key ?? '-',\n  judul: jiraData.fields?.summary ?? '-',\n  tipe_issue: jiraData.fields?.issuetype?.name ?? '-',\n  status: jiraData.fields?.status?.name ?? '-',\n  prioritas_jira: jiraData.fields?.priority?.name ?? '-',\n  assignee: jiraData.fields?.assignee?.displayName ?? 'Unassigned',\n  reporter: jiraData.fields?.reporter?.displayName ?? '-',\n  label: (jiraData.fields?.labels ?? []).join(', ') || '-',\n  tanggal_dibuat: formatDate(jiraData.fields?.created),\n  tanggal_diupdate: formatDate(jiraData.fields?.updated),\n  kategori_ai: aiAnalysis.kategori ?? '-',\n  tingkat_urgensi_ai: aiAnalysis.tingkat_urgensi ?? '-',\n  kompleksitas_ai: aiAnalysis.estimasi_kompleksitas ?? '-',\n  skor_prioritas_ai: aiAnalysis.skor_prioritas ?? '-',\n  ringkasan_ai: aiAnalysis.ringkasan ?? '-',\n  rekomendasi_ai: aiAnalysis.rekomendasi_aksi ?? '-',\n  potensi_dampak_ai: aiAnalysis.potensi_dampak ?? '-',\n  waktu_proses: formatDate(new Date().toISOString())\n};\n\nreturn [{ json: row }];"
      },
